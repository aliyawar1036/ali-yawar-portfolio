rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'ay9642356@gmail.com' ||
        request.auth.token.email == 'aliyawar1036@gmail.com'
      );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidProjectType(val) {
      return val is string && val.size() >= 2 && val.size() <= 60 && (
        val == 'AI Automation' ||
        val == 'AI Agent' ||
        val == 'n8n Workflow' ||
        val == 'Lead Generation' ||
        val == 'Sales Automation' ||
        val == 'Email Automation' ||
        val == 'Business Process Automation' ||
        val == 'API Integration' ||
        val == 'Other'
      );
    }

    function isValidStatus(val) {
      return val is string && val.size() >= 3 && val.size() <= 20 && (
        val == 'new' ||
        val == 'contacted' ||
        val == 'closed'
      );
    }

    function isValidLeadInquiry(data) {
      return data.keys().hasAll([
          'authorUid',
          'name',
          'email',
          'company',
          'projectType',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'authorUid',
          'name',
          'email',
          'company',
          'projectType',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.authorUid) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 120 && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        data.company is string && data.company.size() >= 0 && data.company.size() <= 120 &&
        isValidProjectType(data.projectType) &&
        data.message is string && data.message.size() >= 12 && data.message.size() <= 2000 &&
        isValidStatus(data.status) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules: /inquiries/{inquiryId}
    match /inquiries/{inquiryId} {
      allow get: if isSignedIn() && isValidId(inquiryId) && (
        existing().authorUid == request.auth.uid || isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().authorUid == request.auth.uid || isAdmin()
      );

      allow create: if isSignedIn() &&
        isValidId(inquiryId) &&
        isValidLeadInquiry(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(inquiryId) &&
        isValidLeadInquiry(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isValidId(inquiryId) && isAdmin();
    }

    // 5. Collection Rules: /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (
        request.auth.uid == adminUid || isAdmin()
      );
      allow list: if false;
      allow write: if false;
    }
  }
}
